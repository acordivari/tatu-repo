# Base URL of the Rails API. Copy to .env and adjust per environment.
VITE_API_URL=http://localhost:3000/api/v1

# MapTiler key for the /map page's basemap (free tier: cloud.maptiler.com).
# Required in production — without it the map falls back to OSM's demo tile
# server, which disallows real app traffic. Set it in Netlify's env too.
VITE_MAPTILER_KEY=
